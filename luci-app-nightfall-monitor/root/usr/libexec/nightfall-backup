#!/bin/sh
# Nightfall: local backup and safe restore of settings.
#   nightfall-backup create [FILE]       create an archive (USB/SD next to the history; otherwise /tmp/nightfall-backups/)
# By default the last 5 backups are kept on the external drive (NF_BACKUP_KEEP=1..20).
#   nightfall-backup list FILE           verify the archive and show its contents
#   nightfall-backup restore FILE        preview only
#   nightfall-backup restore FILE apply  restore after verifying the archive
#
# For tests: NF_ROOT, NF_TMP, NF_BACKUP_DIR.
set -u

ROOT=${NF_ROOT:-}
ETC="${ROOT}/etc"
TMP=${NF_TMP:-/tmp}
CONF=${NF_CONF:-$ETC/nightfall-monitor.conf}
MOUNTS=${NF_MOUNTS:-$ROOT/proc/mounts}
VERSION_FILE=${NF_VERSION_FILE:-$ROOT/www/luci-static/nightfall/version.json}
TOOL_VERSION=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$VERSION_FILE" 2>/dev/null | head -n 1)
[ -n "$TOOL_VERSION" ] || TOOL_VERSION=unknown
BACKUP_KEEP=${NF_BACKUP_KEEP:-$(sed -n 's/^BACKUP_KEEP=//p' "$CONF" 2>/dev/null | head -n 1)}
[ -n "$BACKUP_KEEP" ] || BACKUP_KEEP=5
case "$BACKUP_KEEP" in ''|*[!0-9]*) BACKUP_KEEP=5 ;; esac
[ "$BACKUP_KEEP" -ge 1 ] && [ "$BACKUP_KEEP" -le 20 ] || BACKUP_KEEP=5

# By default keep durable backups beside the configured history directory,
# but only when that path is actually covered by a mounted external block device.
backup_mount_dir() {
 p=${NF_PERSIST_DIR:-}
 [ -n "$p" ] || p=$(awk -F= '$1 == "PERSIST_DIR" { v=$2; sub(/^[[:space:]]*"/, "", v); sub(/"[[:space:]]*$/, "", v); sub(/[[:space:]#].*$/, "", v); print v; exit }' "$CONF" 2>/dev/null)
 [ -n "$p" ] && [ "${p#/}" != "$p" ] || return 1
 [ -r "$MOUNTS" ] || return 1
 mi=$(awk -v p="$p" '
  BEGIN { while (length(p)>1 && substr(p,length(p),1)=="/") p=substr(p,1,length(p)-1) }
  { dev=$1; mp=$2; opts=$4; ok=(mp=="/" ? substr(p,1,1)=="/" : (p==mp || index(p,mp "/")==1)); if (ok && opts ~ /(^|,)rw(,|$)/ && length(mp)>best) { best=length(mp); bd=dev; bm=mp } }
  END { if (best) print bd "|" bm }
 ' "$MOUNTS" 2>/dev/null)
 [ -n "$mi" ] || return 1
 dev=${mi%%|*}; mp=${mi#*|}
 case "$mp" in /|/overlay|/rom|/tmp|/root|/boot) return 1 ;; esac
 case "$dev" in /dev/sd[a-z]*|/dev/nvme*|/dev/mmcblk*|/dev/vd[a-z]*) ;; *) return 1 ;; esac
 printf '%s/nightfall-backups' "$mp"
}
if [ -n "${NF_BACKUP_DIR:-}" ]; then
 OUTDIR=$NF_BACKUP_DIR
 BACKUP_STORAGE=explicit
else
 AUTO_BACKUP_DIR=$(backup_mount_dir 2>/dev/null || true)
 if [ -n "$AUTO_BACKUP_DIR" ]; then OUTDIR=$AUTO_BACKUP_DIR; BACKUP_MOUNT=${AUTO_BACKUP_DIR%/nightfall-backups}; BACKUP_STORAGE=external
 else OUTDIR=$TMP/nightfall-backups; BACKUP_STORAGE=temporary
 fi
fi
FILES="
nightfall-monitor.conf
nightfall-prefs.json
nightfall-logo.json
nightfall-bg.json
nightfall-block.list
nightfall-block.log
nightfall-devices.list
nightfall-groups.list
nightfall-known.list
nightfall-apps.list
nightfall-journal.log
nightfall-release.pub
"

fail() { echo "Error: $*" >&2; exit 1; }

prune_backups() {
 host=$1
 [ "$BACKUP_STORAGE" = external ] || return 0
 [ "$BACKUP_KEEP" -ge 1 ] 2>/dev/null || return 0
 # Timestamped names sort newest-first; only this router's completed archives are rotated.
 find "$OUTDIR" -maxdepth 1 -type f -name "nightfall-backup-$host-*.tar.gz" -print 2>/dev/null |
  sort -r | awk -v keep="$BACKUP_KEEP" 'NR > keep { print }' |
  while IFS= read -r old; do
   [ -n "$old" ] && rm -f "$old"
  done
}
base64_available() {
 [ -n "${NF_BASE64:-}" ] && [ -x "$NF_BASE64" ] && return 0
 [ -z "${NF_BASE64:-}" ] && command -v base64 >/dev/null 2>&1 && return 0
 [ -z "${NF_BASE64:-}" ] && command -v busybox >/dev/null 2>&1 && busybox base64 </dev/null >/dev/null 2>&1 && return 0
 return 1
}
# Validate system encoder output before accepting it. Some minimal router
# builds ship a base64 applet which exists but fails on real input; fall back
# to a small POSIX awk encoder for one already-bounded download chunk.
base64_encoded_file() {
 encoded_clean=$(tr -d '\n' < "$1" 2>/dev/null) || return 1
 expected_encoded=$(( (wanted + 2) / 3 * 4 ))
 [ "${#encoded_clean}" -eq "$expected_encoded" ] || return 1
 case "$encoded_clean" in *[!A-Za-z0-9+/=]*) return 1 ;; esac
 printf '%s' "$encoded_clean"
}
base64_encode() {
 input=$1
 encoded_file="$DOWNLOAD_TMP/base64.out"

 if [ -n "${NF_BASE64:-}" ]; then
  if "$NF_BASE64" < "$input" > "$encoded_file" 2>/dev/null && base64_encoded_file "$encoded_file"; then return 0; fi
 elif command -v base64 >/dev/null 2>&1; then
  if base64 < "$input" > "$encoded_file" 2>/dev/null && base64_encoded_file "$encoded_file"; then return 0; fi
 elif command -v busybox >/dev/null 2>&1; then
  if busybox base64 < "$input" > "$encoded_file" 2>/dev/null && base64_encoded_file "$encoded_file"; then return 0; fi
 fi

 # Portable fallback: encode the bounded byte block using od + POSIX awk.
 # The block limit is 24 KiB, so this stays small even on router targets.
 command -v od >/dev/null 2>&1 && command -v awk >/dev/null 2>&1 || return 1
 od -An -v -tu1 "$input" > "$DOWNLOAD_TMP/bytes" 2>/dev/null || return 1
 awk '
  BEGIN { alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" }
  {
   for (i = 1; i <= NF; i++) {
    b[++n] = $i + 0
    if (n == 3) {
     v = b[1] * 65536 + b[2] * 256 + b[3]
     out = out substr(alphabet, int(v / 262144) % 64 + 1, 1)
     out = out substr(alphabet, int(v / 4096) % 64 + 1, 1)
     out = out substr(alphabet, int(v / 64) % 64 + 1, 1)
     out = out substr(alphabet, v % 64 + 1, 1)
     n = 0
    }
   }
  }
  END {
   if (n == 1) {
    v = b[1] * 65536
    out = out substr(alphabet, int(v / 262144) + 1, 1)
    out = out substr(alphabet, int(v / 4096) % 64 + 1, 1) "=="
   }
   else if (n == 2) {
    v = b[1] * 65536 + b[2] * 256
    out = out substr(alphabet, int(v / 262144) + 1, 1)
    out = out substr(alphabet, int(v / 4096) % 64 + 1, 1)
    out = out substr(alphabet, int(v / 64) % 64 + 1, 1) "="
   }
   printf "%s", out
  }
 ' "$DOWNLOAD_TMP/bytes" > "$encoded_file" 2>/dev/null || return 1
 base64_encoded_file "$encoded_file"
}
base64_decode() {
 if [ -n "${NF_BASE64:-}" ]; then "$NF_BASE64" -d; elif command -v base64 >/dev/null 2>&1; then base64 -d; else busybox base64 -d; fi
}
say() { printf '%s\n' "$*"; }
allowed() {
 case "$1" in
  nightfall-monitor.conf|nightfall-prefs.json|nightfall-logo.json|nightfall-bg.json|nightfall-block.list|nightfall-block.log|nightfall-devices.list|nightfall-groups.list|nightfall-known.list|nightfall-apps.list|nightfall-journal.log|nightfall-release.pub) return 0 ;;
  *) return 1 ;;
 esac
}
cleanup() { [ -n "${WORK:-}" ] && rm -rf "$WORK"; [ -n "${RESTORE_STAGE:-}" ] && rm -rf "$RESTORE_STAGE"; [ -n "${DEST_TMP:-}" ] && rm -f "$DEST_TMP"; [ -n "${DOWNLOAD_TMP:-}" ] && rm -rf "$DOWNLOAD_TMP"; return 0; }
trap cleanup EXIT HUP INT TERM

create_backup() {
 dest=${2:-}
 pinned=0
 if [ -z "$dest" ] && [ "$BACKUP_STORAGE" = external ]; then
  # Pin the process working directory to the mounted filesystem. Relative writes
  # cannot fall through to the underlying overlay if USB is detached mid-backup.
  cd "$BACKUP_MOUNT" 2>/dev/null || fail "the external drive was disconnected before the backup was created"
  [ "$(backup_mount_dir 2>/dev/null || true)" = "$BACKUP_MOUNT/nightfall-backups" ] || fail "the mount point changed; the backup was not created"
  OUTDIR=nightfall-backups
  pinned=1
 fi
 [ ! -L "$OUTDIR" ] || fail "the backup directory cannot be a symbolic link"
 mkdir -p "$OUTDIR" 2>/dev/null || fail "failed to create directory $OUTDIR"
 [ -d "$OUTDIR" ] && [ ! -L "$OUTDIR" ] || fail "unsafe backup directory"
 host=$(cat "${ROOT}/proc/sys/kernel/hostname" 2>/dev/null || echo router)
 host=$(printf '%s' "$host" | tr -cd 'A-Za-z0-9_.-')
 [ -n "$host" ] || host=router
 [ -n "$dest" ] || dest="$OUTDIR/nightfall-backup-$host-$(date +%Y%m%d-%H%M%S).tar.gz"
 case "$dest" in *.tar.gz) ;; *) fail "the archive name must end with .tar.gz" ;; esac
 if [ "$pinned" = 1 ]; then display_dest="$BACKUP_MOUNT/$dest"; else display_dest=$dest; fi
 if [ -e "$dest" ] || [ -L "$dest" ]; then
  base=${dest%.tar.gz}; n=1
  while [ -e "$base-$n.tar.gz" ] || [ -L "$base-$n.tar.gz" ]; do n=$((n + 1)); done
  dest="$base-$n.tar.gz"
  if [ "$pinned" = 1 ]; then display_dest="$BACKUP_MOUNT/$dest"; else display_dest=$dest; fi
 fi
 parent=${dest%/*}; [ "$parent" = "$dest" ] && parent=.
 mkdir -p "$parent" 2>/dev/null || fail "failed to create the destination directory"
 WORK=$(mktemp -d "$TMP/nightfall-backup.XXXXXX" 2>/dev/null) || fail "failed to create a temporary directory"
 mkdir -p "$WORK/etc" || fail "failed to prepare the archive"
 count=0
 for f in $FILES; do
  [ -f "$ETC/$f" ] && [ ! -L "$ETC/$f" ] || continue
  cp -p "$ETC/$f" "$WORK/etc/$f" || fail "failed to copy $f"
  count=$((count + 1))
 done
 [ "$count" -gt 0 ] || fail "no Nightfall settings files found on the router"
 if [ -f "$WORK/etc/nightfall-monitor.conf" ]; then
  sed -i 's/^TG_TOKEN=.*/TG_TOKEN=/; s/^TG_PROXY=.*/TG_PROXY=/' "$WORK/etc/nightfall-monitor.conf" || fail "failed to remove secrets from the backup"
 fi
 {
  echo "Nightfall backup"
  echo "format=1"
  echo "tool_version=$TOOL_VERSION"
  echo "created=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "files=$count"
  echo "secrets=TG_TOKEN,TG_PROXY excluded"
  echo "network_config=not included"
 } > "$WORK/MANIFEST.txt"
 (cd "$WORK" && sha256sum etc/nightfall-* > MANIFEST.sha256) || fail "failed to compute checksums"
 { for f in $FILES; do [ -f "$WORK/etc/$f" ] && echo "etc/$f"; done; echo MANIFEST.txt; echo MANIFEST.sha256; } > "$WORK/archive.list"
 DEST_TMP="$dest.tmp"
 tar -czf "$DEST_TMP" -C "$WORK" -T "$WORK/archive.list" || fail "failed to build the archive"
 gzip -t "$DEST_TMP" 2>/dev/null || fail "the created gzip archive failed the integrity check"
 tar -tzf "$DEST_TMP" >/dev/null 2>&1 || fail "the created tar archive failed the contents check"
 [ "$(wc -c < "$DEST_TMP" | tr -d ' ')" -gt 0 ] || fail "an empty archive was created"
 mv "$DEST_TMP" "$dest" || fail "failed to save the archive"
 DEST_TMP=
 chmod 600 "$dest" 2>/dev/null
 prune_backups "$host"
 say "Backup created: $display_dest"
 say "Files: $count"
 if [ "$BACKUP_STORAGE" = external ]; then
  say "Storage: USB/SD ($BACKUP_MOUNT/nightfall-backups); keeping the last $BACKUP_KEEP backups."
 else
  say "Storage: temporary ($OUTDIR); no persistent USB/SD found or PERSIST_DIR is not configured."
 fi
 say "TG_TOKEN and TG_PROXY are not included. OpenWrt network settings are not included."
}
inspect_archive() {
 archive=$1
 [ -f "$archive" ] || fail "archive not found: $archive"
 command -v tar >/dev/null 2>&1 || fail "tar not found"
 command -v sha256sum >/dev/null 2>&1 || fail "sha256sum not found"
 listing="$TMP/nightfall-backup-list.$$"
 tar -tzf "$archive" > "$listing" 2>/dev/null || { rm -f "$listing"; fail "the archive is corrupted or is not a gzip archive"; }
 bad=0; count=0
 while IFS= read -r p; do
  case "$p" in
   etc/nightfall-* )
    name=${p#etc/}
    allowed "$name" || bad=1
    case "$p" in */../*|../*|/*) bad=1 ;; esac
    count=$((count + 1))
    ;;
   MANIFEST.txt|MANIFEST.sha256) ;;
   *) bad=1 ;;
  esac
 done < "$listing"
 rm -f "$listing"
 [ "$bad" = 0 ] || fail "the archive contains invalid paths or files"
 [ "$count" -gt 0 ] || fail "the archive has no Nightfall settings"
 # Only regular files are allowed in the archive; links and special types are denied.
 tar -tvzf "$archive" 2>/dev/null | awk 'substr($1,1,1) != "-" { bad=1 } END { exit bad }' || fail "the archive contains links or special files"
 WORK=$(mktemp -d "$TMP/nightfall-restore.XXXXXX" 2>/dev/null) || fail "failed to create a temporary directory"
 tar -xzf "$archive" -C "$WORK" || fail "failed to extract the archive"
 [ -f "$WORK/MANIFEST.txt" ] && [ -f "$WORK/MANIFEST.sha256" ] || fail "the archive is missing the manifest"
 (cd "$WORK" && sha256sum -c MANIFEST.sha256 >/dev/null 2>&1) || fail "checksums do not match; restore is not allowed"
 find "$WORK" -type l -print | grep -q . && fail "a symbolic link was found in the extracted backup"
 say "Archive verified. Contents:"
 cat "$WORK/MANIFEST.txt"
 for f in $FILES; do
  if [ -f "$WORK/etc/$f" ]; then say "  /etc/$f"; fi
 done
 return 0
}

restore_backup() {
 archive=$1
 mode=${2:-preview}
 inspect_archive "$archive"
 if [ "$mode" != apply ]; then
  say "Preview complete. To restore, run:"
  say "  /usr/libexec/nightfall-backup restore '$archive' apply"
  return 0
 fi
 [ "$mode" = apply ] || fail "unknown mode"
 mkdir -p "$ETC" || fail "failed to open /etc"
 RESTORE_STAGE=$(mktemp -d "$ETC/.nightfall-restore.XXXXXX") || fail "failed to prepare the restore transaction"
 mkdir -p "$RESTORE_STAGE/new" "$WORK/rollback" || fail "failed to prepare temporary files"
 # Keep Telegram secrets in a private file, never in awk command-line arguments.
 SECRET_FILE="$RESTORE_STAGE/secrets"
 (umask 077; : > "$SECRET_FILE") || fail "failed to prepare the protected secrets file"
 chmod 600 "$SECRET_FILE" 2>/dev/null
 if [ -r "$ETC/nightfall-monitor.conf" ]; then
  sed -n '/^TG_TOKEN=/ { p; q; }' "$ETC/nightfall-monitor.conf" >> "$SECRET_FILE" || fail "failed to keep TG_TOKEN"
  sed -n '/^TG_PROXY=/ { p; q; }' "$ETC/nightfall-monitor.conf" >> "$SECRET_FILE" || fail "failed to keep TG_PROXY"
 fi
 : > "$WORK/apply.list"; : > "$WORK/existing.list"; : > "$WORK/missing.list"
 for f in $FILES; do
  [ -f "$WORK/etc/$f" ] || continue
  if [ -L "$ETC/$f" ] || { [ -e "$ETC/$f" ] && [ ! -f "$ETC/$f" ]; }; then
   fail "unsafe type of the current file /etc/$f; restore stopped"
  fi
  cp -p "$WORK/etc/$f" "$RESTORE_STAGE/new/$f" || fail "failed to prepare $f"
  if [ "$f" = nightfall-monitor.conf ]; then
   # Preserve current secrets exactly; remove duplicates from the archive and append missing keys.
   awk -v secret_file="$SECRET_FILE" '
    BEGIN {
     while ((getline secret_line < secret_file) > 0) {
      if (index(secret_line, "TG_TOKEN=") == 1) { token_line=secret_line; have_token=1 }
      if (index(secret_line, "TG_PROXY=") == 1) { proxy_line=secret_line; have_proxy=1 }
     }
     close(secret_file)
     token_done=0; proxy_done=0
    }
    /^TG_TOKEN=/ { if (have_token && !token_done) print token_line; token_done=1; next }
    /^TG_PROXY=/ { if (have_proxy && !proxy_done) print proxy_line; proxy_done=1; next }
    { print }
    END {
     if (have_token && !token_done) print token_line
     if (have_proxy && !proxy_done) print proxy_line
    }
   ' "$RESTORE_STAGE/new/$f" > "$RESTORE_STAGE/new/$f.tmp" || fail "failed to keep the current secrets"
   mv "$RESTORE_STAGE/new/$f.tmp" "$RESTORE_STAGE/new/$f" || fail "failed to prepare the configuration"
  fi
  if [ -f "$ETC/$f" ]; then
   cp -p "$ETC/$f" "$WORK/rollback/$f" || fail "failed to save the current file /etc/$f"
   echo "$f" >> "$WORK/existing.list"
  else
   echo "$f" >> "$WORK/missing.list"
  fi
  echo "$f" >> "$WORK/apply.list"
 done
 while IFS= read -r f; do
  [ -n "$f" ] || continue
  if ! mv "$RESTORE_STAGE/new/$f" "$ETC/$f"; then
   say "Error installing /etc/$f. Restoring the original settings…"
   rollback_error=0
   while IFS= read -r old; do
    [ -n "$old" ] || continue
    # Remove the partially installed file before putting the old one back.
    if rm -f "$ETC/$old" && cp -p "$WORK/rollback/$old" "$ETC/$old.rollback.$" && mv "$ETC/$old.rollback.$" "$ETC/$old"; then :; else rollback_error=1; rm -f "$ETC/$old.rollback.$"; fi
   done < "$WORK/existing.list"
   while IFS= read -r new; do
    [ -n "$new" ] || continue
    rm -f "$ETC/$new" || rollback_error=1
   done < "$WORK/missing.list"
   [ "$rollback_error" = 0 ] && fail "restore cancelled; the original settings were restored" || fail "CRITICAL ERROR: failed to fully restore the original settings. Check /etc manually"
  fi
 done < "$WORK/apply.list"
 chmod 600 "$ETC/nightfall-monitor.conf" 2>/dev/null
 chmod 644 "$ETC/nightfall-prefs.json" "$ETC/nightfall-logo.json" "$ETC/nightfall-bg.json" 2>/dev/null
 say "Nightfall settings restored."
 say "OpenWrt network settings were not changed. TG_TOKEN was kept from the current configuration."
 say "Check TG_PROXY and set it again if needed."
 say "Restart the collector: /etc/init.d/nightfall-collector restart"
}
backup_name() {
 case "${1:-}" in nightfall-backup-*.tar.gz) printf '%s/%s' "$OUTDIR" "$1" ;; *) fail "invalid archive name" ;; esac
}
download_info() {
 archive=$(backup_name "${2:-}")
 [ -f "$archive" ] && [ ! -L "$archive" ] || fail "archive not found"
 size=$(wc -c < "$archive" | tr -d ' ')
 [ "$size" -gt 0 ] || fail "the archive is empty"
 hash=$(sha256sum "$archive" | awk '{ print $1 }') || fail "failed to verify the archive"
 printf "size=%s sha256=%s\n" "$size" "$hash"
}
download_chunk() {
 archive=$(backup_name "${2:-}")
 offset=${3:-}; length=${4:-24576}
 case "$offset:$length" in *[!0-9:]*|:*) fail "invalid download parameters" ;; esac
 [ -f "$archive" ] && [ ! -L "$archive" ] && [ -r "$archive" ] || fail "archive not found or not readable"
 size=$(wc -c < "$archive" | tr -d ' ') || fail "failed to determine the archive size"
 case "$size" in ''|*[!0-9]*) fail "failed to determine the archive size" ;; esac
 [ "$offset" -le "$size" ] || fail "offset is beyond the end of the archive"
 [ "$length" -gt 0 ] && [ "$length" -le 24576 ] || fail "invalid chunk size"
 wanted=$((size - offset)); [ "$wanted" -gt "$length" ] && wanted=$length
 [ "$wanted" -gt 0 ] || fail "requested an empty chunk past the end of the archive"

 # Do not use a tail | head | base64 pipeline: in POSIX shell the exit status
 # of a pipeline hides errors of earlier commands. Check each step separately.
 DOWNLOAD_TMP=$(mktemp -d "$TMP/nightfall-download.XXXXXX") || fail "failed to prepare a temporary chunk"
 tail -c "+$((offset + 1))" "$archive" > "$DOWNLOAD_TMP/tail" 2>/dev/null || fail "failed to read the archive"
 tail_size=$(wc -c < "$DOWNLOAD_TMP/tail" | tr -d ' ') || fail "failed to check the chunk read"
 [ "$tail_size" -ge "$wanted" ] || fail "the archive changed or was not read completely"
 head -c "$wanted" "$DOWNLOAD_TMP/tail" > "$DOWNLOAD_TMP/chunk" 2>/dev/null || fail "failed to extract the archive chunk"
 actual=$(wc -c < "$DOWNLOAD_TMP/chunk" | tr -d ' ') || fail "failed to check the chunk size"
 [ "$actual" -eq "$wanted" ] || fail "incomplete archive chunk: $actual of $wanted bytes"
 base64_encode "$DOWNLOAD_TMP/chunk" > "$DOWNLOAD_TMP/encoded" 2>/dev/null || fail "failed to encode the archive chunk"
 encoded_size=$(tr -d '\n' < "$DOWNLOAD_TMP/encoded" | wc -c | tr -d ' ') || fail "failed to check the encoded chunk"
 expected_size=$(( (wanted + 2) / 3 * 4 ))
 [ "$encoded_size" -eq "$expected_size" ] || fail "incomplete base64 chunk: $encoded_size instead of $expected_size characters"
 tr -d '\n' < "$DOWNLOAD_TMP/encoded" || fail "failed to send the encoded chunk"
 rm -rf "$DOWNLOAD_TMP"; DOWNLOAD_TMP=
}
upload_start() {
 id=${2:-}
 case "$id" in ????????) ;; *) fail "invalid upload identifier" ;; esac
 case "$id" in *[!a-f0-9]*) fail "invalid upload identifier" ;; esac
 mkdir -p "$OUTDIR" 2>/dev/null || fail "failed to create the backup directory"
 umask 077
 upload_file="$OUTDIR/.upload-$id.b64"
 [ ! -e "$upload_file" ] && [ ! -L "$upload_file" ] || fail "the upload identifier is already in use"
 (set -C; : > "$upload_file") 2>/dev/null || fail "failed to safely start the upload"
 say "Upload started."
}
upload_chunk() {
 id=${2:-}; chunk=${3:-}
 case "$id" in ????????) ;; *) fail "invalid upload identifier" ;; esac
 case "$id" in *[!a-f0-9]*) fail "invalid upload identifier" ;; esac
 [ -n "$chunk" ] && [ "${#chunk}" -le 32768 ] || fail "invalid chunk size"
 case "$chunk" in *[!A-Za-z0-9+/=]*) fail "invalid chunk characters" ;; esac
 file="$OUTDIR/.upload-$id.b64"
 [ -f "$file" ] && [ ! -L "$file" ] || fail "upload not found"
 printf '%s' "$chunk" >> "$file" || fail "failed to write the chunk"
 say "Chunk accepted."
}
upload_abort() {
 id=${2:-}
 case "$id" in ????????) ;; *) fail "invalid upload identifier" ;; esac
 case "$id" in *[!a-f0-9]*) fail "invalid upload identifier" ;; esac
 rm -f "$OUTDIR/.upload-$id.b64" "$OUTDIR/nightfall-backup-upload-$id.tar.gz"
 say "Temporary upload deleted."
}
upload_finish() {
 base64_available || fail "base64 not found. Install the coreutils-base64 package (apk add coreutils-base64) or use a BusyBox build with the base64 applet"
 id=${2:-}
 case "$id" in ????????) ;; *) fail "invalid upload identifier" ;; esac
 case "$id" in *[!a-f0-9]*) fail "invalid upload identifier" ;; esac
 encoded="$OUTDIR/.upload-$id.b64"
 archive="$OUTDIR/nightfall-backup-upload-$id.tar.gz"
 [ -f "$encoded" ] && [ ! -L "$encoded" ] || fail "upload not found"
 encoded_size=$(wc -c < "$encoded" | tr -d ' ')
 [ "$encoded_size" -gt 0 ] && [ "$encoded_size" -le 7000000 ] || fail "the archive is empty or larger than 5 MB"
 [ ! -e "$archive.tmp" ] && [ ! -L "$archive.tmp" ] || rm -f "$archive.tmp"
 (set -C; base64_decode < "$encoded" > "$archive.tmp") 2>/dev/null || { rm -f "$archive.tmp"; fail "failed to safely decode the archive"; }
 rm -f "$encoded"
 mv "$archive.tmp" "$archive" || fail "failed to save the archive"
 chmod 600 "$archive" 2>/dev/null
 inspect_archive "$archive"
 say "Archive uploaded: $archive"
}
case "${1:-}" in
 create) create_backup "$@" ;;
 download-info) download_info "$@" ;;
 download) download_chunk "$@" ;;
 upload-start) upload_start "$@" ;;
 upload-chunk) upload_chunk "$@" ;;
 upload-finish) upload_finish "$@" ;;
 upload-abort) upload_abort "$@" ;;
 list) [ -n "${2:-}" ] || fail "specify the archive path"; inspect_archive "$2" ;;
 restore) [ -n "${2:-}" ] || fail "specify the archive path"; restore_backup "$2" "${3:-preview}" ;;
 *) echo "Usage: $0 create [FILE] | list FILE | restore FILE [apply] | download-info NAME | download NAME OFFSET [LENGTH] | upload-start ID | upload-chunk ID BASE64 | upload-finish ID | upload-abort ID" >&2; exit 2 ;;
esac
