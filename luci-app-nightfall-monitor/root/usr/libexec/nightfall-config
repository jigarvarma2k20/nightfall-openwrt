#!/bin/sh
# Nightfall config: reading and safely writing the collector settings (/etc/nightfall-monitor.conf).
#   nightfall-config get                    — current values and defaults (JSON)
#   nightfall-config set KEY=VAL [KEY=VAL…] — validate, write and restart the collector
#   nightfall-config reset                  — restore default settings
#   nightfall-config disks                  — connected drives (JSON)
CONF=${NF_CONF:-/etc/nightfall-monitor.conf}
DEF=${NF_DEF:-/usr/share/nightfall/nightfall-monitor.conf.default}
KEYS="TEMP_WARN TEMP_CRIT MEM_MIN_PCT FLASH_MAX_PCT CT_MAX_PCT CPU_MAX_PCT CPU_MINUTES PING_TARGET PING_TARGET2 PERSIST_DIR PERSIST_HOURS HIST_DAYS BACKUP_KEEP PERSIST_ANY JOURNAL WIFI_HIST SPEED_HOURS SPEED_URL SPEED_STREAMS APPS LITE NEWDEV TG TG_ALERTS TG_TOKEN TG_CHAT TG_USERS TG_PROXY TG_IFACE TG_BOT TG_CLEAN TG_UPDATES TG_SEC TG_WIDGETS TG_REPORT"

val() {     # val FILE KEY
	[ -r "$1" ] && sed -n "s/^$2=\"\{0,1\}\([^ #\"]*\).*/\1/p" "$1" | head -n 1
}

json_obj() {    # json_obj FILE [FALLBACK_FILE]: a key missing from FILE is taken from FALLBACK_FILE
	printf '{'
	n=0
	for k in $KEYS; do
		if [ -r "$1" ] && grep -q "^$k=" "$1"; then v=$(val "$1" "$k"); else v=$(val "${2:-$1}" "$k"); fi
		[ "$n" -gt 0 ] && printf ','
		[ "$k" = TG_TOKEN ] && [ -n "$v" ] && v="***"      # never expose the token
		printf '"%s":"%s"' "$k" "$v"
		n=$((n + 1))
	done
	printf '}'
}

fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }

restart() { [ -n "$NF_NORESTART" ] || { /etc/init.d/nightfall-collector restart >/dev/null 2>&1 & }; }

range() {   # range KEY VAL MIN MAX
	case "$2" in ''|*[!0-9]*) fail "$1: a number is required" ;; esac
	[ "$2" -ge "$3" ] && [ "$2" -le "$4" ] || fail "$1: allowed range is $3 to $4"
}

PREFS=${NF_PREFS:-/etc/nightfall-prefs.json}
LOGO=${NF_LOGO:-/etc/nightfall-logo.json}
BGF=${NF_BGPHOTO:-/etc/nightfall-bg.json}
case "$1" in
logo-set)   # logo-set data:image/...;base64,... | off — custom image on the sign-in screen (served as logo.json)
	v=$2
	if [ "$v" = off ]; then rm -f "$LOGO"; printf '{"ok":true}\n'; exit 0; fi
	[ -n "$v" ] && [ ${#v} -le 90000 ] || fail "the image is empty or too large"
	printf '%s' "$v" | grep -qE '^data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+$' || fail "a png, webp or jpeg image is required"
	printf '{"d":"%s"}\n' "$v" > "$LOGO.tmp" && chmod 644 "$LOGO.tmp" && mv "$LOGO.tmp" "$LOGO" || fail "failed to write the image"
	printf '{"ok":true}\n' ;;
bg-set)     # bg-set data:image/...;base64,... | off — custom background photo on the sign-in screen (served as bg.json)
	v=$2
	if [ "$v" = off ]; then rm -f "$BGF"; printf '{"ok":true}\n'; exit 0; fi
	[ -n "$v" ] && [ ${#v} -le 110000 ] || fail "the photo is empty or too large"
	printf '%s' "$v" | grep -qE '^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$' || fail "a webp or jpeg photo is required"
	printf '{"d":"%s"}\n' "$v" > "$BGF.tmp" && chmod 644 "$BGF.tmp" && mv "$BGF.tmp" "$BGF" || fail "failed to write the photo"
	printf '{"ok":true}\n' ;;
prefs-set)
	v=$2
	[ -n "$v" ] && [ ${#v} -le 8192 ] || fail "theme settings are empty or too large"
	case "$v" in '{'*'}') ;; *) fail "a JSON object was expected" ;; esac
	case "$v" in *'<'*|*'`'*|*'$('*) fail "invalid characters" ;; esac
	if command -v jsonfilter >/dev/null 2>&1; then [ -n "$(jsonfilter -s "$v" -e '@.t' 2>/dev/null)" ] || fail "invalid JSON"; fi
	printf '%s\n' "$v" > "$PREFS.tmp" && chmod 644 "$PREFS.tmp" && mv "$PREFS.tmp" "$PREFS" || fail "failed to write theme settings"
	printf '{"ok":true}\n' ;;
get)
	printf '{"values":'; json_obj "$CONF" "$DEF"
	printf ',"defaults":'; json_obj "$DEF"
	printf '}\n' ;;
set)
	shift
	[ $# -gt 0 ] || fail "no parameters"
	# an empty flag (0/1) is treated as "not set" and gets the default value: this way a page with a field that is not in the settings file yet
	# does not get the whole form rejected (previously "PERSIST_ANY: only 0 or 1 allowed" prevented saving any setting)
	n=$#
	while [ "$n" -gt 0 ]; do
		kv=$1; shift; n=$((n - 1)); k=${kv%%=*}; v=${kv#*=}
		case "$k" in
		JOURNAL|PERSIST_ANY|WIFI_HIST|APPS|LITE|NEWDEV|TG|TG_ALERTS|TG_BOT|TG_CLEAN|TG_WIDGETS|TG_UPDATES|TG_SEC)
			if [ -z "$v" ]; then v=$(val "$DEF" "$k"); [ -n "$v" ] || v=0; kv="$k=$v"; fi ;;
		esac
		set -- "$@" "$kv"
	done
	allow_internal=$(val "$CONF" PERSIST_ANY); [ -n "$allow_internal" ] || allow_internal=$(val "$DEF" PERSIST_ANY); [ -n "$allow_internal" ] || allow_internal=0
	for kv in "$@"; do case "$kv" in PERSIST_ANY=*) allow_internal=${kv#*=} ;; esac; done
	for kv in "$@"; do
		k=${kv%%=*}; v=${kv#*=}
		case " $KEYS " in *" $k "*) ;; *) fail "unknown parameter: $k" ;; esac
		case "$k" in
		TEMP_WARN) range "$k" "$v" 40 120 ;;
		TEMP_CRIT) range "$k" "$v" 50 130 ;;
		MEM_MIN_PCT) range "$k" "$v" 1 90 ;;
		FLASH_MAX_PCT|CT_MAX_PCT|CPU_MAX_PCT) range "$k" "$v" 10 100 ;;
		CPU_MINUTES) range "$k" "$v" 1 60 ;;
		PING_TARGET|PING_TARGET2)
			case "$v" in ''|*[!A-Za-z0-9._:-]*) [ -z "$v" ] || fail "$k: invalid characters" ;; esac
			[ ${#v} -le 64 ] || fail "$k: value is too long" ;;
		PERSIST_HOURS) range "$k" "$v" 1 24 ;;
		HIST_DAYS) range "$k" "$v" 7 90 ;;
		BACKUP_KEEP) range "$k" "$v" 1 20 ;;
		TG_TOKEN)
			[ "$v" = "***" ] && continue       # the UI did not change the token
			[ -z "$v" ] || printf '%s' "$v" | grep -qE '^[0-9]{5,}:[A-Za-z0-9_-]{20,}$' || fail "TG_TOKEN: expected a token like 123456:ABC… from @BotFather" ;;
		TG_CHAT) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^-?[0-9]{3,20}$' || fail "TG_CHAT: a numeric chat id is required" ;;
		TG_USERS) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^[0-9]{3,20}(,[0-9]{3,20}){0,19}$' || fail "TG_USERS: numeric ids separated by commas, for example 123456789,987654321" ;;
		TG_REPORT) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9]$' || fail "TG_REPORT: a time like 21:00 or empty" ;;
		TG_IFACE) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^[A-Za-z0-9_.-]{1,15}$' || fail "TG_IFACE: an interface name is required, for example wg0" ;;
		TG_PROXY) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^(http|https|socks5|socks5h)://[A-Za-z0-9._:@%-]{1,100}$' || fail "TG_PROXY: an address like socks5h://127.0.0.1:1080 or http://host:port is required" ;;
		JOURNAL|PERSIST_ANY|WIFI_HIST|APPS|LITE|NEWDEV|TG|TG_ALERTS|TG_BOT|TG_CLEAN|TG_WIDGETS|TG_UPDATES|TG_SEC) case "$v" in 0|1) ;; *) fail "$k: only 0 or 1 allowed" ;; esac ;;
		SPEED_HOURS) range "$k" "$v" 0 168 ;;
		SPEED_STREAMS) range "$k" "$v" 1 8 ;;
		SPEED_URL)
			case "$v" in http://*|https://*) ;; *) fail "SPEED_URL: an http:// or https:// address is required" ;; esac
			case "$v" in *[!A-Za-z0-9._~:/?=%+-]*) fail "SPEED_URL: invalid characters (letters, digits and . _ ~ : / ? = % + - are allowed)" ;; esac
			[ ${#v} -le 200 ] || fail "SPEED_URL: address is too long" ;;
		PERSIST_DIR)
			if [ -n "$v" ]; then
				case "$v" in /*) ;; *) fail "PERSIST_DIR: an absolute path is required" ;; esac
				case "$v" in *[!A-Za-z0-9._/-]*|*..*) fail "PERSIST_DIR: invalid characters" ;; esac
				case "$v" in /|/etc|/etc/*|/root|/root/*|/rom|/rom/*) fail "PERSIST_DIR: this system path is not allowed" ;; esac
				case "$v" in /overlay|/overlay/*) [ "$allow_internal" = 1 ] || fail "PERSIST_DIR: for internal flash turn on 'Allow saving to built-in storage'" ;; esac
				[ ${#v} -le 100 ] || fail "PERSIST_DIR: path is too long"
			fi ;;
		esac
		eval "new_$k=\$v"
	done
	[ -f "$CONF" ] || cp "$DEF" "$CONF" 2>/dev/null || : > "$CONF"
	tw=${new_TEMP_WARN:-$(val "$CONF" TEMP_WARN)}; tc=${new_TEMP_CRIT:-$(val "$CONF" TEMP_CRIT)}
	[ -z "$tw" ] || [ -z "$tc" ] || [ "$tw" -lt "$tc" ] || fail "TEMP_WARN must be less than TEMP_CRIT"
	cp "$CONF" "$CONF.tmp" || fail "failed to write the configuration"
	for kv in "$@"; do
		k=${kv%%=*}; v=${kv#*=}
		[ "$k" = TG_TOKEN ] && [ "$v" = "***" ] && continue
		if grep -q "^$k=" "$CONF.tmp"; then
			sed "s|^$k=[^ #]*|$k=$v|" "$CONF.tmp" > "$CONF.tmp2" && mv "$CONF.tmp2" "$CONF.tmp"
		else
			printf '%s=%s\n' "$k" "$v" >> "$CONF.tmp"
		fi
	done
	chmod 600 "$CONF.tmp" 2>/dev/null     # contains the bot token
	mv "$CONF.tmp" "$CONF" || fail "failed to write the configuration"
	restart
	printf '{"ok":true}\n' ;;
disks)
	# connected USB drives, SD cards and disks (not the router system partition) where history can be saved
	M=${NF_MOUNTS:-/proc/mounts}; DFB=${NF_DF:-df}
	rd=$($DFB -P / 2>/dev/null | awk 'NR == 2 { print $1 }'); od=$($DFB -P /overlay 2>/dev/null | awk 'NR == 2 { print $1 }')
	printf '{"disks":['; n=0
	while read -r dev mnt fs opts _; do
		case "$dev" in /dev/sd[a-z]*|/dev/nvme*|/dev/mmcblk*|/dev/vd[a-z]*) ;; *) continue ;; esac
		case "$mnt" in /|/overlay|/overlay/*|/rom|/rom/*|/boot|/boot/*|/tmp|/tmp/*|/proc|/sys|/dev|/dev/*|/etc|/etc/*) continue ;; esac
		case "$mnt" in *[!A-Za-z0-9._/-]*) continue ;; esac
		[ "$dev" = "$rd" ] && continue
		[ "$dev" = "$od" ] && continue
		case ",$opts," in *,rw,*) ;; *) continue ;; esac
		kb=$($DFB -kP "$mnt" 2>/dev/null | awk 'NR == 2 { print $2, $4 }')
		[ -n "$kb" ] || continue
		[ "$n" -gt 0 ] && printf ','
		printf '{"dev":"%s","mount":"%s","fs":"%s","size_kb":%s,"free_kb":%s}' "$dev" "$mnt" "$fs" "${kb% *}" "${kb#* }"
		n=$((n + 1))
	done < "$M"
	printf '],"parts":['
	# partitions the kernel sees that are not mounted (for the "why is the list empty" hint)
	n=0
	while read -r _ _ blocks name; do
		case "$name" in sd[a-z][0-9]*|nvme[0-9]*n[0-9]*p[0-9]*|mmcblk[0-9]*p[0-9]*|vd[a-z][0-9]*) ;; *) continue ;; esac
		grep -q "^/dev/$name " "$M" 2>/dev/null && continue
		bt=; command -v blkid >/dev/null 2>&1 && bt=$(blkid -o value -s TYPE "/dev/$name" 2>/dev/null | head -n 1 | tr -cd 'A-Za-z0-9_')
		[ "$n" -gt 0 ] && printf ','
		printf '{"dev":"/dev/%s","size_kb":%s,"type":"%s"}' "$name" "${blocks:-0}" "$bt"
		n=$((n + 1))
	done < "${NF_PARTS:-/proc/partitions}"
	printf '],"fs":['
	n=0
	for f in ext4 vfat exfat ntfs3 ntfs f2fs btrfs; do
		grep -qw "$f" "${NF_FSF:-/proc/filesystems}" 2>/dev/null || continue
		[ "$n" -gt 0 ] && printf ','
		printf '"%s"' "$f"; n=$((n + 1))
	done
	us=0; { [ -d "${NF_USBMOD:-/sys/module/usb_storage}" ] || grep -q '^usb_storage ' "${NF_MODS:-/proc/modules}" 2>/dev/null; } && us=1
	printf '],"usb_storage":%s}\n' "$us" ;;
reset)
	cp "$DEF" "$CONF" || fail "failed to write the configuration"
	restart
	printf '{"ok":true}\n' ;;
*)
	echo "usage: nightfall-config get | set KEY=VAL… | reset | disks" >&2
	exit 1 ;;
esac
