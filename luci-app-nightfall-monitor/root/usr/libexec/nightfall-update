#!/bin/sh
# Nightfall: theme update straight from the UI.
#   nightfall-update start    starts the update in the background and returns immediately
#   nightfall-update status   prints JSON with the state: {"state":"...","pct":N,"msg":"..."}
#   nightfall-update check    compares the installed version with the latest release: {"installed":"X","latest":"Y","new":0|1}
#   nightfall-update run      the update itself (started by start)
#
# Order: download the archive and the checksum file (.sha256) -> verify sha256 ->
# verify the usign signature (if the router has the public key /etc/nightfall-release.pub) ->
# save a copy of the files being replaced -> extract -> reload rpcd.
# On an error after installation has started, a verified rollback is performed; its failure is recorded separately.
#
# For tests: NF_ROOT (root instead of /), NF_TMP, NF_BASE (download source), NF_NORELOAD=1.

ROOT=${NF_ROOT:-}
TMP=${NF_TMP:-/tmp}
REPO="jigarvarma2k20/nightfall-openwrt"
BASE=${NF_BASE:-https://github.com/$REPO/releases/latest/download}
ST="$TMP/nightfall-update.status"
LOCK="$TMP/nightfall-update.lock"
WORK="$TMP/nightfall-update"
VERF="$ROOT/www/luci-static/nightfall/version.json"
PUB="$ROOT/etc/nightfall-release.pub"

state() { # state pct msg
	printf '{"state":"%s","pct":%s,"msg":"%s"}\n' "$1" "$2" "$3" > "$ST.new" && mv "$ST.new" "$ST"
}

version() {
	sed -n 's/.*"version"[^"]*"\([^"]*\)".*/\1/p' "$VERF" 2>/dev/null | head -n1
}

fetch() { # url out
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --retry 2 --connect-timeout 15 --max-time 300 -o "$2" "$1"
	elif command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -O "$2" "$1"
	else
		return 127
	fi
}

rollback() {
	# Delete all files that did not exist before the update. A deletion error
	# must not be hidden: otherwise the new version may partially remain.
	ROLLBACK_ERROR=0
	if [ -f "$WORK/added.list" ]; then
		while IFS= read -r f; do
			[ -n "$f" ] || continue
			case "$f" in /*|../*|*/../*|*/..) ROLLBACK_ERROR=1; continue ;; esac
			rm -f "$ROOT/$f" 2>/dev/null || ROLLBACK_ERROR=1
			if [ -e "$ROOT/$f" ] || [ -L "$ROOT/$f" ]; then ROLLBACK_ERROR=1; fi
		done < "$WORK/added.list"
	fi

	# If old files existed, the backup is mandatory.
	if [ -f "$WORK/backup.tar.gz" ]; then
		tar -xzf "$WORK/backup.tar.gz" -C "${ROOT:-/}" 2>/dev/null || ROLLBACK_ERROR=1
	elif [ -s "$WORK/exist.list" ]; then
		ROLLBACK_ERROR=1
	fi

	# Check the restore result, not just the tar exit code.
	if [ -f "$WORK/exist.list" ]; then
		while IFS= read -r f; do
			[ -n "$f" ] || continue
			if [ ! -e "$ROOT/$f" ] && [ ! -L "$ROOT/$f" ]; then ROLLBACK_ERROR=1; fi
		done < "$WORK/exist.list"
	fi
	[ "$ROLLBACK_ERROR" -eq 0 ]
}

fail() { # msg [rollback]
	if [ -n "$2" ]; then
		if rollback; then
			state rolledback 100 "$1 Changes were reverted, the previous files were restored."
		else
			state rollback_failed 100 "$1 CRITICAL ERROR: the automatic rollback did NOT complete. Manual restore from the backup is required."
		fi
	else
		state error 100 "$1"
	fi
	rmdir "$LOCK" 2>/dev/null
	exit 1
}

case "$1" in
check)
	API=${NF_API:-https://api.github.com/repos/$REPO/releases/latest}
	mkdir -p "$TMP" 2>/dev/null; j="$TMP/nightfall-update.api"; rm -f "$j"
	fetch "$API" "$j" 2>/dev/null
	l=$(sed -n 's/.*"tag_name"[^"]*"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' "$j" 2>/dev/null | head -n1); rm -f "$j"
	i=$(version)
	[ -n "$l" ] || { printf '{"installed":"%s","latest":"","new":0}\n' "$i"; exit 1; }
	n=$(awk -v a="$i" -v b="$l" 'BEGIN { x = split(a, p, "."); y = split(b, q, "."); m = x > y ? x : y; for (k = 1; k <= m; k++) { u = p[k] + 0; v = q[k] + 0; if (v > u) { print 1; exit } if (v < u) { print 0; exit } } print 0 }')
	printf '{"installed":"%s","latest":"%s","new":%s}\n' "$i" "$l" "$n"
	;;

status)
	if [ -f "$ST" ]; then cat "$ST"; else printf '{"state":"idle","pct":0,"msg":""}\n'; fi
	;;

start)
	if [ -d "$LOCK" ] && [ -f "$ST" ] && ! grep -q '"state":"\(done\|error\|rolledback\|rollback_failed\)"' "$ST"; then
		# already running; if the record is older than 10 minutes, treat it as stuck
		if [ -z "$(find "$ST" -mmin +10 2>/dev/null)" ]; then
			cat "$ST"; exit 0
		fi
		rmdir "$LOCK" 2>/dev/null
	fi
	state starting 1 "Starting"
	# setsid and closed streams: the process outlives the call from rpcd
	if command -v setsid >/dev/null 2>&1; then
		setsid sh "$0" run </dev/null >/dev/null 2>&1 &
	else
		sh "$0" run </dev/null >/dev/null 2>&1 &
	fi
	cat "$ST"
	;;

run)
	mkdir "$LOCK" 2>/dev/null || exit 0
	rm -rf "$WORK"; mkdir -p "$WORK" || fail "Failed to create the work directory."
	OLD=$(version)

	command -v curl >/dev/null 2>&1 || command -v uclient-fetch >/dev/null 2>&1 \
		|| fail "curl not found. Install it with: apk add curl"

	state downloading 10 "Downloading the archive"
	fetch "$BASE/nightfall-root.tar.gz" "$WORK/new.tar.gz" || fail "Failed to download the archive. Check the internet connection."
	state downloading 40 "Downloading the checksum"
	fetch "$BASE/nightfall-root.tar.gz.sha256" "$WORK/new.sha256" || fail "The release has no checksum file, update stopped."

	state verifying 55 "Verifying the checksum"
	WANT=$(sed -n '1s/[[:space:]].*//p' "$WORK/new.sha256" | tr 'A-F' 'a-f')
	GOT=$(sha256sum "$WORK/new.tar.gz" | sed 's/[[:space:]].*//')
	[ -n "$WANT" ] && [ "$WANT" = "$GOT" ] || fail "Checksum mismatch, the archive was not installed."

	# signature: if the public key is installed, a release without a valid signature is not installed
	if [ -f "$PUB" ]; then
		command -v usign >/dev/null 2>&1 || fail "usign not found, nothing to verify the release signature with."
		state verifying 58 "Verifying the signature"
		fetch "$BASE/nightfall-root.tar.gz.sig" "$WORK/new.sig" || fail "The release has no signature, update stopped."
		usign -V -m "$WORK/new.tar.gz" -p "$PUB" -x "$WORK/new.sig" >/dev/null 2>&1 || fail "The release signature does not match, the archive was not installed."
	fi

	tar -tzf "$WORK/new.tar.gz" > "$WORK/all.list" 2>/dev/null || fail "The archive is corrupted."
	grep -q 'luci-static/nightfall/' "$WORK/all.list" || fail "The archive has no Nightfall theme files."
	grep -q 'luci-static/nightfall/version.json' "$WORK/all.list" || fail "The archive has no version file."
	# Check every path component: deny absolute paths and ".."
	# in any position (including a trailing component "foo/..").
	awk '
	{
		p=$0
		if (substr(p,1,1) == "/") bad=1
		if (substr(p,1,2) == "./") p=substr(p,3)
		n=split(p, part, "/")
		for (i=1; i<=n; i++) if (part[i] == "..") bad=1
	}
	END { exit bad }
	' "$WORK/all.list" || fail "The archive contains invalid paths."
	# Allow only the 7 standard Nightfall symlinks; other links and special files are denied.
	tar -tvzf "$WORK/new.tar.gz" > "$WORK/verbose.list" 2>/dev/null || fail "Failed to check the archive entry types."
	# Allow only the standard Nightfall symlinks; any other links and special files are denied.
	validate_archive_types() {
	  awk '
	  function allowed(p, t) {
	    return (p == "./usr/share/ucode/luci/template/themes/nightfall-dark" && t == "nightfall") ||
	           (p == "./usr/share/ucode/luci/template/themes/nightfall-light" && t == "nightfall") ||
	           (p == "./www/luci-static/nightfall-dark" && t == "nightfall") ||
	           (p == "./www/luci-static/nightfall-light" && t == "nightfall") ||
	           (p == "./www/luci-static/nightfall/bg.json" && t == "/etc/nightfall-bg.json") ||
	           (p == "./www/luci-static/nightfall/prefs.json" && t == "/etc/nightfall-prefs.json") ||
	           (p == "./www/luci-static/nightfall/logo.json" && t == "/etc/nightfall-logo.json")
	  }
	  {
	    type=substr($0,1,1)
	    if (type == "-" || type == "d") next
	    if (type != "l") { bad=1; next }
	    n=split($0, pair, " -> ")
	    if (n != 2) { bad=1; next }
	    path=pair[1]; sub(/^.* /, "", path)
	    target=pair[2]
	    if (!allowed(path,target) || seen[path]++) bad=1
	  }
	  END { exit bad }
	  ' "$1"
	}
	validate_archive_types "$WORK/verbose.list" || fail "The archive contains invalid links or special files."
	EXPECTED=$( { tar -xzOf "$WORK/new.tar.gz" ./www/luci-static/nightfall/version.json 2>/dev/null || tar -xzOf "$WORK/new.tar.gz" www/luci-static/nightfall/version.json 2>/dev/null; } | sed -n 's/.*"version"[^"]*"\([^"]*\)".*/\1/p' | head -n1)
	[ -n "$EXPECTED" ] || fail "The archive is missing a valid version file."

	state installing 65 "Saving a copy of the current files"
	sed 's|^\./||; /\/$/d; /^$/d' "$WORK/all.list" > "$WORK/files.list"
	: > "$WORK/exist.list"; : > "$WORK/added.list"
	while IFS= read -r f; do
		if [ -e "$ROOT/$f" ] || [ -L "$ROOT/$f" ]; then echo "$f" >> "$WORK/exist.list"; else echo "$f" >> "$WORK/added.list"; fi
	done < "$WORK/files.list"
	if [ -s "$WORK/exist.list" ]; then
		tar -czf "$WORK/backup.tar.gz" -C "${ROOT:-/}" -T "$WORK/exist.list" 2>/dev/null || fail "Failed to save a copy of the current files."
	fi

	state installing 75 "Installing"
	tar -xzf "$WORK/new.tar.gz" -C "${ROOT:-/}" || fail "Extraction error." rollback
	[ -f "$VERF" ] || fail "The theme version was not found after installation." rollback
	[ "$(version)" = "$EXPECTED" ] || fail "After installation the version did not match the archive version; the previous files were restored." rollback

	chmod 755 "$ROOT"/usr/libexec/nightfall-* "$ROOT"/etc/init.d/nightfall-collector 2>/dev/null
	for f in "$ROOT/etc/uci-defaults/30_luci-theme-nightfall" "$ROOT/etc/uci-defaults/40_nightfall-collector"; do
		[ -f "$f" ] && { sh "$f" >/dev/null 2>&1; rm -f "$f"; }
	done
	rm -f "$ROOT/www/luci-static/resources/view/nightfall/sysauth.js"
	rm -rf "$TMP"/luci-indexcache* "$TMP"/luci-modulecache 2>/dev/null
	# theme settings files must be readable by the web server (otherwise prefs.json returns Forbidden)
	chmod 644 "${ROOT:-}"/etc/nightfall-prefs.json "${ROOT:-}"/etc/nightfall-logo.json "${ROOT:-}"/etc/nightfall-bg.json 2>/dev/null

	NEW=$(version)
	rm -rf "$WORK"
	rmdir "$LOCK" 2>/dev/null
	# first the result, then the rpcd reload (it refreshes access rights)
	state done 100 "Installed: ${OLD:-?} -> ${NEW:-?}"
	if [ -z "$NF_NORELOAD" ]; then
		/etc/init.d/nightfall-collector restart >/dev/null 2>&1
		/etc/init.d/rpcd reload >/dev/null 2>&1 || /etc/init.d/rpcd restart >/dev/null 2>&1
	fi
	;;

*)
	echo "Usage: $0 start|status|run" >&2
	exit 1
	;;
esac
