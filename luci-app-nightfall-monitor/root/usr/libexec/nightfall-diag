#!/bin/sh
# Nightfall: network diagnostics from the Resource Monitor.
#   nightfall-diag ping HOST   — 4 packets, summary
#   nightfall-diag trace HOST  — route to the host (traceroute, if installed)
#   nightfall-diag check       — gateway, internet and DNS in one check
#   nightfall-diag dns HOST    — name resolution through the router DNS
#   nightfall-diag route HOST  — loss and latency at each hop of the route (traceroute, 2 packets per hop, no longer than 24 seconds: otherwise the router cuts the response)
#   nightfall-diag bloat       — latency idle and under load (bufferbloat); needs curl
# The host is validated strictly: only letters, digits, dot, colon, hyphen (at most 253 characters, must not start with "-").
cmd=$1; host=$2
if [ "$cmd" = check ]; then   # quick check: gateway, internet, DNS with one button
	gw=$(ip -4 route show default 2>/dev/null | awk '/default/ { for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit } }')
	one() {  # one HOST: response and average time
		o=$(ping -c 3 -W 2 "$1" 2>&1) || { echo "fail"; return; }
		echo "$o" | awk '/min\/avg\/max|round-trip/ { sub(/.*= */, ""); split($0, a, "/"); printf "%.0f ms", a[2]; found = 1 } END { if (!found) printf "responds" }'
	}
	if [ -n "$gw" ]; then r=$(one "$gw"); [ "$r" = fail ] && echo "❌ Gateway $gw is not responding" || echo "✅ Gateway $gw: $r"; else echo "❌ Default route not found (no connection to the ISP)"; fi
	for h in 1.1.1.1 8.8.8.8; do r=$(one "$h"); [ "$r" = fail ] && echo "❌ Internet: $h is not responding" || echo "✅ Internet: $h — $r"; done
	for h in ya.ru google.com; do
		s=$(date +%s%N 2>/dev/null)
		if nslookup "$h" >/dev/null 2>&1; then
			e=$(date +%s%N 2>/dev/null)
			case "$s$e" in *N*|'') echo "✅ DNS: $h resolves" ;; *) echo "✅ DNS: $h resolves in $(( (e - s) / 1000000 )) ms" ;; esac
		else echo "❌ DNS: $h does not resolve"; fi
	done
	exit 0
fi
if [ "$cmd" = bloat ]; then   # latency idle and under load: a large difference is a sign of bufferbloat
	CURL=${NF_CURL:-curl}; PING=${NF_PING:-ping}; URL=${NF_BLOATURL:-https://speed.cloudflare.com/__down?bytes=200000000}
	command -v "$CURL" >/dev/null 2>&1 || { echo "curl is needed to create load: apk add curl"; exit 1; }
	avgp() { $PING -c 6 -W 2 1.1.1.1 2>&1 | awk '/min\/avg\/max|round-trip/ { sub(/.*= */, ""); split($0, a, "/"); printf "%.0f", a[2]; f = 1 } END { if (!f) printf "0" }'; }
	idle=$(avgp)
	[ "$idle" -gt 0 ] || { echo "❌ No response from 1.1.1.1: check the internet connection"; exit 1; }
	pids=""
	for i in 1 2 3; do $CURL -s -m 14 -o /dev/null "$URL" & pids="$pids $!"; done
	sleep 3
	load=$(avgp)
	kill $pids 2>/dev/null
	echo "Latency to 1.1.1.1 idle: $idle ms"
	if [ "$load" -le 0 ]; then echo "Under load: no responses (the link is completely saturated)"; echo "Conclusion: severe bufferbloat. Turn on SQM (luci-app-sqm, cake)."; exit 0; fi
	d=$((load - idle)); [ "$d" -lt 0 ] && d=0
	echo "Latency under load (3-stream download): $load ms (+$d ms)"
	if [ "$d" -lt 30 ]; then echo "Conclusion: excellent, the queue does not bloat."
	elif [ "$d" -lt 100 ]; then echo "Conclusion: noticeable. Video calls and games may lag when the link is busy. SQM (luci-app-sqm, cake) will help."
	else echo "Conclusion: severe bufferbloat. Turn on SQM (luci-app-sqm, cake) and set the speed to about 90% of your plan."; fi
	exit 0
fi
case "$host" in ''|-*|*[!A-Za-z0-9._:-]*) echo "Invalid host address"; exit 2 ;; esac
[ "${#host}" -le 253 ] || { echo "Address is too long"; exit 2; }
case "$cmd" in
ping)
	command -v ping >/dev/null 2>&1 || { echo "ping not found"; exit 1; }
	ping -c 4 -W 2 "$host" 2>&1 ;;
trace)
	if command -v traceroute >/dev/null 2>&1; then
		traceroute -n -w 2 -q 1 -m 15 "$host" 2>&1
	else
		echo "traceroute is not installed. Install it: apk add traceroute (or opkg install traceroute)"
	fi ;;
route)
	command -v traceroute >/dev/null 2>&1 || { echo "traceroute is not installed. Install it: apk add traceroute (or opkg install traceroute)"; exit 0; }
	echo "Hop   Address             Loss    Average"
	traceroute -n -w 1 -q 2 -m 12 "$host" 2>&1 | awk '
		NR == 1 { next }
		$1 ~ /^[0-9]+$/ {
			lost = 0; got = 0; sum = 0; ip = "-"
			for (i = 2; i <= NF; i++) {
				if ($i == "*") lost++
				else if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ || $i ~ /:/) { if (ip == "-") ip = $i }
				else if ($i == "ms") { got++; sum += $(i - 1) }
			}
			printf "%-5s %-19s %3d%%    %s\n", $1, ip, (lost * 100 + (lost + got) / 2) / (lost + got > 0 ? lost + got : 1), got ? sprintf("%.1f ms", sum / got) : "–"
		}'
	echo
	echo "Loss at an intermediate hop that does not continue further is usually harmless: the hop simply does not answer service packets." ;;
dns)
	command -v nslookup >/dev/null 2>&1 || { echo "nslookup not found"; exit 1; }
	s=$(date +%s%N 2>/dev/null)
	nslookup "$host" 2>&1
	e=$(date +%s%N 2>/dev/null)
	case "$s$e" in *N*|'') ;; *) echo; echo "Response time: $(( (e - s) / 1000000 )) ms" ;; esac ;;
*)
	echo "usage: nightfall-diag ping|trace|route|dns HOST | check | bloat" >&2; exit 1 ;;
esac
